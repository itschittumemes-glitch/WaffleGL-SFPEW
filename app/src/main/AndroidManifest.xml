<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:label="MGLegacy">

        <!-- The screen you see when you open the app -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FCL finds renderer plugins by looking for this -->
        <meta-data android:name="fclPlugin" android:value="true" />

        <!-- Format:  DisplayName:GL_library:EGL_library
             The two library names are a best guess. If the game crashes, this is the first thing to change. -->
        <meta-data
            android:name="renderer"
            android:value="MGLegacy:libSimpleFPEWrapper.so:libmobileglues.so" />

        <meta-data
            android:name="des"
            android:value="Plugin" />

        <!-- ENVIRONMENT VARIABLES (optional, format unverified)
             Copy the exact format from the manifest of the base ANGLE plugin APK,
             then remove the comment markers around these lines and edit them.

        <meta-data android:name="pojavEnv" android:value="..." />
        <meta-data android:name="boatEnv" android:value="..." />
        -->

    </application>
</manifest>
